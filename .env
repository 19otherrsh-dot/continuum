# ---------------------------------------------------------------------------
# Continuum CRM — environment
# Copy to `.env` at the repo root. Every value below has a working default for
# local development; the product runs end to end with none of them set.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://continuum:password@localhost:5434/continuum"
PORT=3001
NODE_ENV=development
JWT_SECRET="dev-only-change-me"
WEB_ORIGIN="http://localhost:5173"

# --- Providers --------------------------------------------------------------
# simulator = deterministic fixture providers, no credentials needed (default)
# live      = real Google / Microsoft / Twilio / e-sign adapters
PROVIDER_MODE=simulator

# Google Workspace (Gmail + Calendar) — one connection covers both
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/integrations/google/callback"

# Microsoft 365 (Outlook + Calendar) — one connection covers both
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI="http://localhost:3001/api/v1/integrations/microsoft/callback"

# Telephony (native calling + recording)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL="http://localhost:3001"

# Slack notifications
SLACK_BOT_TOKEN=

# E-signature
DROPBOX_SIGN_API_KEY=

# --- AI ---------------------------------------------------------------------
# When unset, Continuum falls back to a deterministic local summarizer. The
# fallback is deliberately conservative: it rarely clears the confidence
# threshold, so the agent stays silent rather than guessing.
ANTHROPIC_API_KEY=
CONTINUUM_AI_MODEL=claude-opus-5

# --- Encryption -------------------------------------------------------------
# 32-byte key, base64. Used to encrypt provider OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="ZGV2LW9ubHktaW5zZWN1cmUta2V5LTMyLWJ5dGVzISE="
